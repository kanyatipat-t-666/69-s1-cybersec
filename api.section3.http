Authorization: Bearer dc8babe0bb49799f323aa0b4ba4a15ac6863b115dcfe8442e197d2db0cdc35f5d769e1bf83075d275b36c72053fcc6fb192002883337e5fa5775b6be38459865dfe7f3345bf735b9cef969a8acf083b749d07be4924eaa54cc303f503484136a6439c278511809bb685274d75e83ec8106ec534daf4d7e5087d5079e96eacbff

### ผลลัพธ์ 200: { "data": [ { "id": 1, "attributes": { "name": "Cyber Security" } } ], "meta": { "pagination": { ... } } }

### 3.3.3 Update Subject

PUT http://localhost:9091/api/subjects/{{createSubject.response.body.$.data.id}}
Content-Type: application/json
Authorization: Bearer dc8babe0bb49799f323aa0b4ba4a15ac6863b115dcfe8442e197d2db0cdc35f5d769e1bf83075d275b36c72053fcc6fb192002883337e5fa5775b6be38459865dfe7f3345bf735b9cef969a8acf083b749d07be4924eaa54cc303f503484136a6439c278511809bb685274d75e83ec8106ec534daf4d7e5087d5079e96eacbff

{
